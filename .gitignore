# Local tools, caches, runtime data and compiled binaries
/.tools/
/.cache/
/data/
/bin/

# Local configuration; keep the example for a fresh checkout
.env
.env.*
!.env.example

# Test output and profiling
coverage
coverage.*
*.coverprofile
*.prof
*.test
*.log

# Database files and private certificates
*.db
*.db-shm
*.db-wal
*.pem
*.key

# Archives, editor settings and OS metadata
*.zip
*.tar.gz
.idea/
.vscode/
.DS_Store
Thumbs.db

# Required by the Dockerfile, including in source archives
!/data-placeholder/
!/data-placeholder/.keep
